{
  "name": "Two players: create, join, coin toss, opening hands, start of turn 1",
  "steps": [
    { "t": "join", "by": "A", "name": "Pack", "deck": ["T 001"], "refuse": "No room yet" },
    { "t": "create", "by": "A", "seed": "scenario-1", "mode": "online", "seats": 2 },
    { "t": "create", "by": "A", "seed": "again", "mode": "online", "seats": 2, "refuse": "already exists" },
    { "t": "join", "by": "A", "name": "Pack", "deckName": "Dragons", "deck": { "repeat": ["T 001", "T 101", "T 201", "T 301", "T 401"], "n": 50 } },
    { "t": "join", "by": "A", "name": "Pack again", "deck": ["T 001"], "refuse": "already have a seat" },
    { "expect": "stage", "eq": "lobby" },
    { "t": "move", "by": "A", "card": "0-0", "to": { "z": "hand" }, "refuse": "not started" },
    { "t": "join", "by": "B", "name": "Friend", "deckName": "Vampires", "deck": { "repeat": ["T 004", "T 102"], "n": 50 } },
    { "events": { "e": "order" } },
    { "expect": "stage", "eq": "mulligan" },
    { "expect": "turn.order", "len": 2 },
    { "expect": "players.0.zones.hand", "len": 7 },
    { "expect": "players.1.zones.hand", "len": 7 },
    { "expect": "players.0.zones.deck", "len": 43 },
    { "expect": "players.1.deckSize", "eq": 50 },
    { "t": "join", "by": "C", "name": "Late", "deck": ["T 001"], "refuse": "already started" },
    { "t": "mulligan", "by": "B" },
    { "expect": "players.1.mulligans", "eq": 1 },
    { "expect": "players.1.zones.hand", "len": 7 },
    { "t": "keep", "by": "A" },
    { "expect": "stage", "eq": "mulligan" },
    { "t": "keep", "by": "B" },
    { "events": { "e": "stage", "stage": "play" } },
    { "events": { "e": "phase", "phase": "draw" } },
    { "events": { "e": "drawSkipped" } },
    { "events": { "e": "factionCheckDone" } },
    { "expect": "stage", "eq": "play" },
    { "expect": "turn.number", "eq": 1 },
    { "expect": "turn.phase", "eq": "active" },
    { "t": "keep", "by": "B", "refuse": "Only before the first turn" }
  ]
}
